# App
APP_HOST=
APP_PORT=8000
APP_URL=${APP_HOST}:${APP_PORT}
APP_ENV=development # Options: development, production
ALLOWED_ORIGINS=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Deezer
DEEZER_CLIENT_ID=
DEEZER_CLIENT_SECRET=

# Logs
LOG_LEVEL=DEBUG

# Cache
CACHE_TTL=3600

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Clips
CLIP_PROVIDERS=deezer
CLIP_CACHING=true
